# National Reporter - Environment Variables
# Copy this to .env and fill your keys

# OpenAI for AI Processing (GPT-4)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Facebook Graph API
# Get from: https://developers.facebook.com/ -> Your App -> Graph API Explorer
# Need: pages_manage_posts, pages_read_engagement, pages_show_list
FACEBOOK_PAGE_ID=100085918100245
FACEBOOK_PAGE_ACCESS_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional
LOG_LEVEL=INFO
SCHEDULE_HOURS=2

# For Make.com / Bannerbear alternative (optional)
BANNERBEAR_API_KEY=
APITEMPLATE_API_KEY=
